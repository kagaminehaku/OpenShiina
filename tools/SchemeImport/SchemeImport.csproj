<Project Sdk="Microsoft.NET.Sdk">

  <!-- The ShiinaRio schemes of GARbro's Formats.dat into our Formats.Json (Program.cs). It reads
       the BinaryFormatter data with System.Formats.Nrbf, which comes with the Windows desktop
       framework, so no GARbro build is needed. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>schemeimport</AssemblyName>
  </PropertyGroup>

</Project>
