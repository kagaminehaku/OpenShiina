<Project Sdk="Microsoft.NET.Sdk">

  <!-- Compares GDI's Ellipse (GdiShapes, Windows) with DibShapes, which draws it for the players
       without Windows: GdiEllipseCheck [random cases] [seed], GdiEllipseCheck show w h, or
       GdiEllipseCheck dump (what GDI draws, to work out its rules) -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\OpenShiina.Core\OpenShiina.Core.csproj" />
  </ItemGroup>

</Project>
