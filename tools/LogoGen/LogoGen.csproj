<Project Sdk="Microsoft.NET.Sdk">

  <!-- Draws OpenShiina's logo (a locked book whose keyhole is a shii nut, and the wordmark with
       S, i, n in red) from its shapes: LogoGen [repository folder] writes docs/logo (SVG, PNG),
       the Windows icon and the Android launcher icons -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
  </ItemGroup>

</Project>
