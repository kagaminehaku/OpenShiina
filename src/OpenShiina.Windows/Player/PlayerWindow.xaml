<Window x:Class="OpenShiina.Windows.PlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OpenShiina.Windows"
        Title="Play Story" Width="1040" Height="810" MinWidth="480" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="Black" Foreground="#E0E0E6"
        FontFamily="Segoe UI, Yu Gothic UI, Meiryo"
        Icon="/OpenShiina;component/Resources/icon.ico"
        PreviewKeyDown="Window_PreviewKeyDown" PreviewKeyUp="Window_PreviewKeyUp"
        PreviewMouseWheel="Window_PreviewMouseWheel">

    <Window.Resources>
        <Style x:Key="BarBtn" TargetType="Button">
            <Setter Property="Background" Value="#2A2A34"/>
            <Setter Property="Foreground" Value="#EEEEF2"/>
            <Setter Property="BorderBrush" Value="#3E3E4E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#38384A"/>
                                <Setter Property="BorderBrush" Value="#7C4DFF"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="On">
                                <Setter Property="Background" Value="#5314D6"/>
                                <Setter Property="BorderBrush" Value="#7C4DFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MenuBtn" TargetType="Button" BasedOn="{StaticResource BarBtn}">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
    </Window.Resources>

    <Grid Background="Black" MouseLeftButtonUp="Screen_MouseLeftButtonUp" MouseRightButtonUp="Screen_MouseRightButtonUp">
        <Viewbox Stretch="Uniform">
            <Grid x:Name="Screen" Width="800" Height="600" ClipToBounds="True" Background="Black">

                <Canvas x:Name="StageCanvas" IsHitTestVisible="False"/>

                <!-- Message window: SYSTEM.S25 slot 0 at (70,451), name plates 30+ -->
                <Canvas x:Name="MessageLayer" Visibility="Collapsed">
                    <Image x:Name="ImgWindow" Canvas.Left="70" Canvas.Top="451" Width="682" Height="147" Stretch="Fill" IsHitTestVisible="False"/>
                    <Border x:Name="WindowFallback" Canvas.Left="70" Canvas.Top="451" Width="682" Height="147" IsHitTestVisible="False"
                            Background="#B0203048" BorderBrush="#8090C0" BorderThickness="2" CornerRadius="10" Visibility="Collapsed"/>
                    <Image x:Name="ImgNamePlate" Stretch="Fill" IsHitTestVisible="False"/>
                    <TextBlock x:Name="TxtName" Canvas.Left="150" Canvas.Top="458" FontSize="17" FontWeight="Bold" IsHitTestVisible="False"
                               Foreground="#FFF6C8" FontFamily="MS Gothic, ＭＳ ゴシック, Yu Gothic"/>
                    <!-- Text area of START.SCN: (126,456), 575 wide, right margin 701 -->
                    <local:MessageText x:Name="TxtMessage" Canvas.Left="126" Canvas.Top="456" Width="575" Height="140" IsHitTestVisible="False"/>
                    <!-- Click wait icon: SYSTEM2.S25 slot 20 at its own offset -->
                    <Image x:Name="TxtNext" Stretch="None" Visibility="Collapsed" IsHitTestVisible="False">
                        <Image.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.3" Duration="0:0:0.6"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Image.Triggers>
                    </Image>
                    <!-- Bottom button bar of the message window: SYSTEM.S25 slots 80-190 -->
                    <Canvas x:Name="BarLayer"/>
                </Canvas>

                <!-- Choices -->
                <Canvas x:Name="ChoiceLayer" Visibility="Collapsed" Background="Transparent"/>

                <!-- Mode indicator -->
                <TextBlock x:Name="TxtMode" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,12,0"
                           FontSize="14" FontWeight="Bold" Foreground="White" IsHitTestVisible="False">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="4" ShadowDepth="1"/>
                    </TextBlock.Effect>
                </TextBlock>

                <!-- Title screen of TOPMENU.SCN: TITLE.S25 buttons over its background -->
                <Canvas x:Name="TitleLayer" Visibility="Collapsed" Background="Transparent"/>

                <!-- Backlog page: SYSTEM.S25 slot 900 with its TOP / END bar -->
                <Canvas x:Name="LogLayer" Visibility="Collapsed" Background="Transparent"/>

                <!-- OPTION page: SYSTEM.S25 slot 1000 -->
                <Canvas x:Name="OptionLayer" Visibility="Collapsed" Background="Black"/>

                <!-- SAVE / LOAD pages -->
                <Canvas x:Name="SaveLayer" Visibility="Collapsed" Background="Black"/>

                <!-- YES / NO dialog: SYSTEM.S25 231 / 232 -->
                <Canvas x:Name="DialogLayer" Visibility="Collapsed" Background="Transparent"/>

                <!-- Chapter list -->
                <Grid x:Name="MenuLayer" Background="#F2101016" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Margin="32,26,32,10">
                        <TextBlock x:Name="TxtTitle" FontSize="30" FontWeight="Bold" FontFamily="Meiryo, Yu Gothic UI"/>
                        <TextBlock x:Name="TxtSubtitle" FontSize="12" Foreground="#9A9AAE" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        <TextBlock FontSize="12" Foreground="#9A9AAE" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Text="Click, Enter: next  ·  Right click, H: hide the text  ·  Wheel up, L: backlog  ·  Ctrl (hold), S: skip  ·  A: auto  ·  Esc: this menu  ·  F11: full screen  ·  move the mouse to the top for the tool bar"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="32,6,32,14">
                        <Button x:Name="BtnResume" Content="▶ Resume" Style="{StaticResource MenuBtn}" Click="BtnResume_Click" Visibility="Collapsed"/>
                        <Button x:Name="BtnStart" Content="▶ Start from the beginning" Style="{StaticResource MenuBtn}" Click="BtnStart_Click"/>
                        <Button Content="Close" Style="{StaticResource MenuBtn}" Click="BtnClose_Click"/>
                    </StackPanel>
                    <DockPanel Grid.Row="2" Margin="32,0,32,24">
                        <TextBlock DockPanel.Dock="Top" Text="Chapters (double-click to start there; the story continues from it)" FontSize="12"
                                   Foreground="#9A9AAE" Margin="0,0,0,6"/>
                        <ListBox x:Name="ChapterList" Background="#181820" Foreground="#E0E0E6" BorderBrush="#2E2E3A"
                                 FontFamily="Meiryo, Yu Gothic UI" FontSize="14" MouseDoubleClick="ChapterList_MouseDoubleClick"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#B79CFF" Margin="4,8,0,2"/>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListBox.GroupStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Title}" Margin="14,1,0,1"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Grid>
            </Grid>
        </Viewbox>

        <!-- Tool bar: appears when the mouse is near the top of the window -->
        <Border x:Name="ToolBar" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,6,0,0" Padding="6"
                Background="#E0181820" BorderBrush="#3E3E4E" BorderThickness="1" CornerRadius="8" Opacity="0"
                MouseEnter="ToolBar_MouseEnter" MouseLeave="ToolBar_MouseLeave"
                MouseLeftButtonUp="ToolBar_MouseButtonUp" MouseRightButtonUp="ToolBar_MouseButtonUp">
            <StackPanel Orientation="Horizontal">
                <Button Content="☰ Chapters" Style="{StaticResource BarBtn}" Click="BtnMenu_Click" ToolTip="Chapter list (Esc)"/>
                <Button x:Name="BtnAuto" Content="Auto" Style="{StaticResource BarBtn}" Click="BtnAuto_Click" ToolTip="Advance by itself after each line (A)"/>
                <Button x:Name="BtnSkip" Content="Skip" Style="{StaticResource BarBtn}" Click="BtnSkip_Click" ToolTip="Fast-forward to the next choice (S, or hold Ctrl)"/>
                <Button Content="Save" Style="{StaticResource BarBtn}" Click="BtnSave_Click" ToolTip="Save"/>
                <Button Content="Load" Style="{StaticResource BarBtn}" Click="BtnLoad_Click" ToolTip="Load"/>
                <Button Content="Log" Style="{StaticResource BarBtn}" Click="BtnLog_Click" ToolTip="Backlog (L or mouse wheel up)"/>
                <Button Content="Hide" Style="{StaticResource BarBtn}" Click="BtnHide_Click" ToolTip="Hide the message window (H or right click)"/>
                <Button Content="⛶" Style="{StaticResource BarBtn}" Click="BtnFullScreen_Click" ToolTip="Full screen (F11)"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
