<Project Sdk="Microsoft.NET.Sdk">

  <!-- OpenShiina on Android phones and tablets (Avalonia): the same player as the desktop's
       (OpenShiina.App), with the sound on AudioTrack, the games read from the device's storage
       (all files access) and the touch controls. Needs the .NET Android workload:
       dotnet workload install android -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>OpenShiina.Android</RootNamespace>
    <AssemblyName>OpenShiina</AssemblyName>
    <ApplicationId>com.kagaminehaku.openshiina</ApplicationId>
    <ApplicationTitle>OpenShiina</ApplicationTitle>
    <!-- The version code Android compares to install over an older APK: the hour of the build,
         UTC, as yyMMddHH (2026-10-12 10:xx -> 26101210), so a newer build always goes over an
         older one, whether made here or by the release workflow (a lower code is refused as a
         downgrade, "package invalid", and uninstalling deletes the saves). Two builds in one
         hour have the same code, which Android takes when the key is the same -->
    <ApplicationVersion>$([System.DateTime]::UtcNow.ToString('yyMMddHH'))</ApplicationVersion>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
  </PropertyGroup>

  <!-- The runtime: CoreCLR (experimental in .NET 10, the only runtime for phones from .NET 11 on),
       the desktop's JIT with Vector128 as NEON and tiered PGO. A phone's perf.log of the same
       skipping in Bitch Nee-chan (2026-10-12): Mono ahead of time with LLVM 26.9 frames a second,
       the compositor 3.33 ms a call, its alpha pixels 4.23 ns (AdvSimd not there, the vectors
       hardly faster than plain code); CoreCLR 40.2, 1.74 ms, 2.02 ns. Phones and tablets of
       today and the emulator (CoreCLR has no 32-bit ARM there). A Release build is ReadyToRun
       already (composite: Microsoft.Android.Sdk.CoreCLR.targets sets PublishReadyToRun and
       PublishReadyToRunComposite), the hot methods compiled again by the JIT. Its own
       intermediate folder, apart from the Mono build's. -->
  <PropertyGroup Condition="'$(OpenShiinaMono)' != 'true'">
    <UseMonoRuntime>false</UseMonoRuntime>
    <RuntimeIdentifiers>android-arm64;android-x64</RuntimeIdentifiers>
    <OutputPath>..\..\bin\$(Configuration)\OpenShiina.Android\</OutputPath>
    <IntermediateOutputPath>obj\$(Configuration)-coreclr\</IntermediateOutputPath>
  </PropertyGroup>

  <!-- -p:OpenShiinaMono=true: Mono, as before 2026-10-12, for 32-bit Android too (Android Go
       phones, TV boxes, where the scripts' memory is mapped in 16 MB parts:
       Scripting/ScnAddressSpace.cs). Release compiles every assembly ahead of time with LLVM's
       optimiser (minutes longer). Its own output and intermediate folders. -->
  <PropertyGroup Condition="'$(OpenShiinaMono)' == 'true'">
    <RuntimeIdentifiers>android-arm64;android-arm;android-x64</RuntimeIdentifiers>
    <OutputPath>..\..\bin\$(Configuration)\OpenShiina.Android.Mono\</OutputPath>
    <IntermediateOutputPath>obj\$(Configuration)-mono\</IntermediateOutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(OpenShiinaMono)' == 'true' and '$(Configuration)' == 'Release'">
    <RunAOTCompilation>true</RunAOTCompilation>
    <EnableLLVM>true</EnableLLVM>
  </PropertyGroup>

  <PropertyGroup>
    <Product>OpenShiina</Product>
    <Version>0.1.0</Version>
    <Authors>kagaminehaku</Authors>
    <Copyright>Copyright (c) 2026 kagaminehaku. Portions Copyright (c) 2014-2020 morkt (GARbro).</Copyright>
  </PropertyGroup>

  <!-- The schemes, which the desktop players keep next to the program: in the package, copied
       out to the app's folder at start (MainApplication) -->
  <ItemGroup>
    <AndroidAsset Include="..\OpenShiina.Core\Data\Formats.Json" Link="Assets\Formats.Json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Android" Version="12.1.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenShiina.App\OpenShiina.App.csproj" />
  </ItemGroup>

  <!-- Thread pool workers go to sleep as soon as they run out of work instead of spinning for
       more (the game's work comes in bursts, Parallel.For a frame: spinning kept cores busy
       while the game waited) -->
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.Threading.ThreadPool.UnfairSemaphoreSpinLimit" Value="0" />
  </ItemGroup>

</Project>
