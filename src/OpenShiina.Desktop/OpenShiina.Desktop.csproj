<Project Sdk="Microsoft.NET.Sdk">

  <!-- OpenShiina on Windows, Linux and macOS (Avalonia): OpenShiina [game folder] -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>OpenShiina</AssemblyName>
    <RootNamespace>OpenShiina.Desktop</RootNamespace>
    <ApplicationIcon>..\OpenShiina.Windows\Resources\icon.ico</ApplicationIcon>
    <OutputPath>..\..\bin\$(Configuration)\OpenShiina.Desktop\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <PropertyGroup>
    <Product>OpenShiina</Product>
    <AssemblyTitle>OpenShiina</AssemblyTitle>
    <Version>0.1.0</Version>
    <Authors>kagaminehaku</Authors>
    <Copyright>Copyright (c) 2026 kagaminehaku. Portions Copyright (c) 2014-2020 morkt (GARbro).</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <!-- The native Wayland backend, used with OPENSHIINA_WAYLAND=1 (experimental in Avalonia 12.1) -->
    <PackageReference Include="Avalonia.Wayland" Version="12.1.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenShiina.App\OpenShiina.App.csproj" />
  </ItemGroup>

</Project>
