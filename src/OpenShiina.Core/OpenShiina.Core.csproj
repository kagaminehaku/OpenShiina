<Project Sdk="Microsoft.NET.Sdk">

  <!-- The engine without a user interface: archives, decoders, the game folder and the SCN
       interpreter. No WPF, so every front end (Windows now; Linux, macOS, Android, iOS later)
       uses the same code. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>OpenShiina</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <Product>OpenShiina</Product>
    <Description>An unofficial, open-source player for visual novels made with the ShiinaRio (椎名里緒) engine.</Description>
    <Version>0.1.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Authors>kagaminehaku</Authors>
    <Copyright>Copyright (c) 2026 kagaminehaku. Portions Copyright (c) 2014-2020 morkt (GARbro).</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <!-- Strings.resx is English: English needs no satellite assembly -->
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

  <!-- Scheme data (keys of each game, their ShiinaImage inside), copied next to the program that uses the engine -->
  <ItemGroup>
    <None Update="Data\Formats.Json" CopyToOutputDirectory="PreserveNewest" TargetPath="Formats.Json" />
  </ItemGroup>

  <!-- SCN opcode operand layouts per engine version (ScnOpcodes) -->
  <ItemGroup>
    <EmbeddedResource Include="Data\ScnOps\*.tsv" LogicalName="OpenShiina.ScnOps.%(Filename).tsv" />
  </ItemGroup>

  <!-- The players' words: Localization/Strings.resx in English, Strings.<language>.resx the
       translations. All of them go into this assembly (no satellite assemblies: Android's
       packaging leaves those out), each as OpenShiina.Localization.Strings[.<language>].resources,
       read by Localization/Languages.cs. The class Strings, a property a word, is written from
       Strings.resx's names (OpenShiinaStrings); Languages.Translated lists the translations. -->
  <ItemGroup>
    <EmbeddedResource Update="Localization\Strings.*.resx" WithCulture="false" LogicalName="OpenShiina.Localization.%(Filename).resources" />
  </ItemGroup>

  <Target Name="OpenShiinaStrings" BeforeTargets="BeforeCompile;CoreCompile">
    <XmlPeek XmlInputPath="Localization\Strings.resx" Query="/root/data/@name">
      <Output TaskParameter="Result" ItemName="_OpenShiinaWord" />
    </XmlPeek>
    <ItemGroup>
      <_OpenShiinaTranslation Include="Localization\Strings.*.resx" />
      <_OpenShiinaLanguage Include="$([System.String]::Copy('%(_OpenShiinaTranslation.Filename)').Substring(8))" />
      <_OpenShiinaStringsLine Include="// Written by the build from Localization/Strings.resx (OpenShiina.Core.csproj)%3B do not edit." />
      <_OpenShiinaStringsLine Include="namespace OpenShiina.Localization%3B" />
      <_OpenShiinaStringsLine Include="/// &lt;summary&gt;The players' words, in the screens' language (Languages.Text).&lt;/summary&gt;" />
      <_OpenShiinaStringsLine Include="public static class Strings" />
      <_OpenShiinaStringsLine Include="{" />
      <_OpenShiinaStringsLine Include="@(_OpenShiinaWord->'    public static string %(Identity) => Languages.Text(&quot;%(Identity)&quot;)%3B')" />
      <_OpenShiinaStringsLine Include="}" />
    </ItemGroup>
    <PropertyGroup>
      <_OpenShiinaLanguages>@(_OpenShiinaLanguage->'&quot;%(Identity)&quot;', ', ')</_OpenShiinaLanguages>
    </PropertyGroup>
    <ItemGroup>
      <_OpenShiinaStringsLine Include="public static partial class Languages { public static readonly string[] Translated = [$(_OpenShiinaLanguages)]%3B }" />
    </ItemGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)Strings.g.cs" Lines="@(_OpenShiinaStringsLine)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)Strings.g.cs" />
      <FileWrites Include="$(IntermediateOutputPath)Strings.g.cs" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="NLayer" Version="3.0.0" />
    <PackageReference Include="NVorbis" Version="0.10.5" />
    <!-- The mixer only; each front end plays it on its own sound device -->
    <PackageReference Include="NAudio.Core" Version="2.2.1" />
    <!-- Decodes the x86 code embedded in SCN modules (Scripting/X86Cpu) -->
    <PackageReference Include="Iced" Version="1.21.0" />
  </ItemGroup>

</Project>
