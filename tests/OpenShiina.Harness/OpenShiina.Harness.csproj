<Project Sdk="Microsoft.NET.Sdk">

  <!-- Runs the Windows player off screen and muted, clicks through the story and takes
       screenshots: harness <mode> <start file|-> <out dir> <clicks> <shot every>.
       Player data goes to <out dir>\data (OPENSHIINA_DATA), never to the real %AppData%. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>harness</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\OpenShiina.Windows\OpenShiina.Windows.csproj" />
  </ItemGroup>

</Project>
